# Copy to .env and fill in real values. Never commit .env.

PORT=4000
NODE_ENV=development
# Required in production; use a long random value, distinct from the admin key.
# Cookies: bosch.sid, HttpOnly, SameSite=Lax, 24 hours; Secure in production.
SESSION_SECRET=
# Trusted reverse proxies: 1 for Hostinger HTTPS termination, 0 for direct dev.
TRUST_PROXY=1
# Optional frontend origin; defaults to http://localhost:3000 outside production.
# Prefer the Vite /api and /uploads proxies so frontend/API share an origin.
WEB_ORIGIN=
SITE_URL=https://boschtechnologies.com
# Optional absolute persistent directory; default is apps/server/data.
# Migrate existing data/testimonials.json here before first deployment.
# /uploads serves only DATA_DIR/uploads; JSON/CSV remain private.
DATA_DIR=

# --- Email (replaces PHP's mail() in api/submit-assessment.php) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=admin@boschtechnologies.com

# --- Testimonial admin (replaces $admin_key in api/manage-testimonial.php) ---
ADMIN_SESSION_SECRET=

# --- Client proposal access codes (replaces $access_code in clients/*/*.php) ---
CLIENT_ACCESS_CODE_WECONNECTU=
CLIENT_ACCESS_CODE_COMOTION=
CLIENT_ACCESS_CODE_TOOMUCHIWIFI=
