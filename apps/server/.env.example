# Copy to .env and fill in real values. Never commit .env.

PORT=4000

# --- Email (replaces PHP's mail() in api/submit-assessment.php) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=admin@boschtechnologies.com

# --- Testimonial admin (replaces $admin_key in api/manage-testimonial.php) ---
ADMIN_SESSION_SECRET=

# --- Client proposal access codes (replaces $access_code in clients/*/*.php) ---
CLIENT_ACCESS_CODE_WECONNECTU=
CLIENT_ACCESS_CODE_COMOTION=
CLIENT_ACCESS_CODE_TOOMUCHIWIFI=
